#!/bin/bash
set -euo pipefail

echo "Starting Sleeping Beauty..."

# Start llama-server (chat) on host
if systemctl --user is-active --quiet llama-chat.service; then
    echo "  llama-chat already running"
else
    systemctl --user start llama-chat.service
    echo "  llama-chat started on :8080"
fi

# Start Docker Compose services
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"

docker compose -f "$REPO_DIR/docker-compose.yaml" up -d
echo "  Docker services started (chroma, gateway, open-webui)"

echo ""
echo "Sleeping Beauty is awake."
echo "  Open WebUI:  http://localhost:3000"
echo "  Gateway:     http://localhost:8800/health"
