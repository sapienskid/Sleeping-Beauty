[Unit]
Description=Sleeping Beauty LLM Server (llama.cpp on :@LLM_PORT@)
PartOf=sleeping-beauty.service
@NETWORK_UNIT_LINES@StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
@SYSTEM_USER_LINES@WorkingDirectory=@PROJECT_DIR@
Environment=PATH=/opt/cuda/bin:/usr/local/bin:/usr/bin:/bin
Environment=LD_LIBRARY_PATH=/opt/cuda/lib64:@LLAMA_BIN_DIR@
ExecStart=@LLAMA_SERVER_BIN@ --host @LLAMA_HOST@ --port @LLM_PORT@ -m @LLM_MODEL@ -ngl @LLAMA_NGL@ -fa on -c @LLAMA_CTX@ --jinja
ExecStartPost=/usr/bin/bash -c 'for _ in $(seq 1 60); do /usr/bin/curl -sf http://127.0.0.1:@LLM_PORT@/health >/dev/null 2>&1 && exit 0; sleep 0.5; done; exit 1'
Restart=on-failure
RestartSec=3
TimeoutStopSec=15s
LimitNOFILE=1048576

[Install]
WantedBy=@WANTED_BY@
