# /etc/default/llama-cpp
# Reference template for llama-cpp.service values.
# The actual /etc/default/llama-cpp file is generated from project .env
# by scripts/install-llama-systemd.sh.

LLAMA_SERVER_BIN=/home/sapiens/llama.cpp/build-cuda/bin/llama-server
LLAMA_HOST=0.0.0.0
LLAMA_PORT=10000
LLAMA_MODELS_DIR=/home/sapiens/models
LLAMA_N_GPU_LAYERS=20
LLAMA_CONTEXT_SIZE=4096
LLAMA_PARALLEL=1
LLAMA_BATCH_SIZE=128
LLAMA_UBATCH_SIZE=32
LLAMA_KV_CACHE_TYPE_K=q8_0
LLAMA_KV_CACHE_TYPE_V=q8_0
