[Unit]
Description=llama.cpp server (embedding)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/llama-server \
    --model %h/models/current-embed.gguf \
    --alias sleeping-beauty-embed \
    --host 127.0.0.1 \
    --port 8085 \
    --embedding \
    --ctx-size 512 \
    --n-gpu-layers 0 \
    --threads 4
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
