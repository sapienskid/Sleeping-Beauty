# Copy this file to .env and set your HF_TOKEN.
#
# ──────────────────────────────────────────────────────────────
#  Sleeping Beauty Local AI — Single config for the full stack
# ──────────────────────────────────────────────────────────────

# ── Open WebUI ────────────────────────────────────────────────
OPENWEBUI_PORT=3000
WEBUI_NAME=Sleeping Beauty Local AI
ENABLE_OLLAMA_API=False
ENABLE_OPENAI_API=True
OPENAI_API_BASE_URL=http://host.docker.internal:10000/v1
OPENAI_API_BASE_URLS=http://host.docker.internal:10000/v1
OPENAI_API_KEY=sk-local
OPENAI_API_KEYS=sk-local

# ── Document extraction (Docling) ────────────────────────────
# Base image supports: PDF, DOCX, XLSX, PPTX, HTML, Markdown,
# images (PNG/JPEG/TIFF/BMP/WEBP), CSV, LaTeX, AsciiDoc, and more.
# EPUBs: convert to HTML first (e.g. Calibre), then upload.
CONTENT_EXTRACTION_ENGINE=docling
DOCLING_SERVER_URL=http://docling:5001
DOCLING_IMAGE=ghcr.io/docling-project/docling-serve:latest
DOCLING_PORT=5001
DOCLING_SERVE_ENABLE_UI=true
DOCLING_SERVE_MAX_SYNC_WAIT=600
DOCLING_SERVE_ENG_LOC_NUM_WORKERS=2
DOCLING_SERVE_ENG_LOC_SHARE_MODELS=true
DOCLING_SERVE_LOAD_MODELS_AT_BOOT=true
DOCLING_NUM_THREADS=6
DOCLING_PERF_PAGE_BATCH_SIZE=4

# ── Vector database (Qdrant) ─────────────────────────────────
VECTOR_DB=qdrant
QDRANT_URI=http://qdrant:6333
QDRANT_ON_DISK=true
QDRANT_PREFER_GRPC=true
QDRANT_GRPC_PORT=6334
QDRANT_HNSW_M=16
QDRANT_COLLECTION_PREFIX=sleeping-beauty
QDRANT_PORT=6333

# ── Embeddings (Qwen3-Embedding-0.6B via sentence-transformers on CPU) ──
RAG_EMBEDDING_ENGINE=
RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RAG_EMBEDDING_BATCH_SIZE=8
RAG_EMBEDDING_QUERY_PREFIX=Instruct: Given a web search query, retrieve relevant passages that answer the query\n

# ── RAG retrieval tuning ──────────────────────────────────────
ENABLE_RAG_HYBRID_SEARCH=true
RAG_HYBRID_BM25_WEIGHT=0.30
RAG_TOP_K=6
RAG_RELEVANCE_THRESHOLD=0.15
CHUNK_SIZE=800
CHUNK_OVERLAP=150
ENABLE_MARKDOWN_HEADER_TEXT_SPLITTER=true
ENABLE_RAG_LOCAL_WEB_FETCH=true

# ── Audio: Text-to-Speech (OpenAI Edge TTS — zero VRAM) ──────
# Uses Microsoft Edge's free neural voices via a local Docker container.
# The key can be any string, but it must match on both sides.
# No GPU required.
# Browse available voices: http://localhost:5050/v1/audio/voices
AUDIO_TTS_ENGINE=openai
AUDIO_TTS_MODEL=tts-1
AUDIO_TTS_VOICE=en-US-AndrewNeural
AUDIO_TTS_OPENAI_API_BASE_URL=http://edge-tts:5050/v1
AUDIO_TTS_OPENAI_API_KEY=sk-edge-tts
EDGE_TTS_API_KEY=sk-edge-tts
EDGE_TTS_REQUIRE_API_KEY=true
EDGE_TTS_PORT=5050
EDGE_TTS_DEFAULT_VOICE=en-US-AndrewNeural
EDGE_TTS_DEFAULT_LANGUAGE=en-US

# ── Audio: Speech-to-Text (Open WebUI built-in Whisper, CPU) ─
# Empty AUDIO_STT_ENGINE = use built-in Whisper (runs on CPU, no VRAM).
# Models: tiny, base, small, medium, large. "base" is fast & accurate enough.
AUDIO_STT_ENGINE=
WHISPER_MODEL=base
WHISPER_LANGUAGE=en

# ── Paths ─────────────────────────────────────────────────────
MODELS_DIR=/home/sapiens/models
LLAMA_CPP_REPO_DIR=/home/sapiens/llama.cpp
LLAMA_CPP_BUILD_DIR=/home/sapiens/llama.cpp/build-cuda
LLAMA_SERVER_BIN=/home/sapiens/llama.cpp/build-cuda/bin/llama-server

# ── llama.cpp runtime (GTX 1650 4GB tuned) ────────────────────
LLAMA_HOST=0.0.0.0
LLAMA_PORT=10000
LLAMA_N_GPU_LAYERS=10
LLAMA_CONTEXT_SIZE=4096
LLAMA_PARALLEL=1
LLAMA_BATCH_SIZE=128
LLAMA_UBATCH_SIZE=32
LLAMA_KV_CACHE_TYPE_K=q8_0
LLAMA_KV_CACHE_TYPE_V=q8_0
LLAMA_MODELS_MAX=1
LLAMA_CACHE_RAM=1400

# ── Hugging Face ──────────────────────────────────────────────
HF_TOKEN=
HF_HUB_DOWNLOAD_TIMEOUT=30
HF_DOWNLOAD_ENABLE_XET_HIGH_PERFORMANCE=true
HF_DOWNLOAD_INCLUDE_PATTERN=*.gguf
