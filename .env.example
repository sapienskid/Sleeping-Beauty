# ──────────────────────────────────────────────────────────────
#  Sleeping Beauty — Local Knowledge Search & RAG Hub
# ──────────────────────────────────────────────────────────────

# ── Web Hub & Server ──────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
PROJECT_NAME="Sleeping Beauty"

# ── Vector Database (LanceDB in-process, zero Docker) ──────────
LANCEDB_DIR=./data/lancedb
TABLE_NAME=knowledge_chunks

# ── Embedding Model (EmbeddingGemma-2 default) ─────────────────
# Options:
#   google/embeddinggemma-2   (768d multimodal/multilingual, MRL support)
#   google/embeddinggemma-300m (300M lightweight)
#   BAAI/bge-small-en-v1.5    (ultra-lightweight CPU fallback)
EMBEDDING_MODEL=google/embeddinggemma-2
EMBEDDING_DEVICE=cuda
EMBEDDING_DTYPE=float16
EMBEDDING_DIM=768
# Optional: truncate dimension via Matryoshka Representation Learning (e.g. 512, 256)
# EMBEDDING_MRL_DIM=512
EMBEDDING_BATCH_SIZE=64

# ── Retrieval & Chunking ──────────────────────────────────────
# Strict chunk budget optimized for 1-2B micro LLMs:
CHUNK_SIZE=400
CHUNK_OVERLAP=80
RAG_TOP_K=4

# ── Local LLM (llama-server running on host GPU :10000) ────────
LLAMA_SERVER_URL=http://127.0.0.1:10000/v1
LLAMA_API_KEY=sk-local
LLM_MODEL_NAME=Qwen3.5-2B
LLM_GGUF_PATH=/home/sapiens/models/Qwen3.5-2B-Q8_0.gguf
LLM_TEMPERATURE=0.05
LLM_MAX_TOKENS=1024

# ── Paths & Models for llama.cpp ──────────────────────────────
MODELS_DIR=/home/sapiens/models
LLAMA_CPP_REPO_DIR=/home/sapiens/llama.cpp
LLAMA_CPP_BUILD_DIR=/home/sapiens/llama.cpp/build-cuda
LLAMA_SERVER_BIN=/home/sapiens/llama.cpp/build-cuda/bin/llama-server

# ── llama.cpp runtime (GTX 1650 4GB tuned for 1-2B micro LLMs) ─
LLAMA_HOST=0.0.0.0
LLAMA_PORT=10000
# 1-2B models fit 100% on the GPU:
LLAMA_N_GPU_LAYERS=99
LLAMA_CONTEXT_SIZE=102400
LLAMA_PARALLEL=1
LLAMA_BATCH_SIZE=512
LLAMA_UBATCH_SIZE=64
LLAMA_KV_CACHE_TYPE_K=q8_0
LLAMA_KV_CACHE_TYPE_V=q8_0
LLAMA_MODELS_MAX=1
LLAMA_CACHE_RAM=2048

# ── Hugging Face ──────────────────────────────────────────────
HF_TOKEN=
